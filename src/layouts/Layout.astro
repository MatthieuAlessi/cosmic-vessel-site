---
import '@styles/global.css';
import { Icon } from 'astro-icon/components';
import { trailerVideoId } from '@data/settings';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Un mod Origin pour Baldur\'s Gate 3 — Nouveau personnage, classe inédite, questline complète.',
  image = '/og-default.jpg',
} = Astro.props;

// Trailer par défaut, utilisé par tout déclencheur [data-trailer-open] sans data-video-id.
const trailerYouTubeId = trailerVideoId;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;

// Cloudflare Web Analytics : token public, défini en variable d'env Netlify.
// Absent en local => pas de beacon en dev, le trafic de dev ne pollue pas les stats.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="fr">
  <head>


    
    <meta charset="UTF-8" />

    <script is:inline>
      document.documentElement.classList.add("js")
    </script>


<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Analytics (Cloudflare Web Analytics — sans cookie, sans bannière) -->
    {
      import.meta.env.PROD && cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }

    <title>{title}</title>
  </head>
  <body>
    <!-- Rideau de transition de page (brouillard noir). Démarre couvert => sert
         aussi de loader d'intro ; révélé au load par le script is:inline ci-dessous.
         5 splats grunge (union = 100% du viewport) en cascade + fond noir de
         sécurité (comble tout trou). --tf = transform de répartition, --i = rang cascade. -->
    <div id="page-fade" data-covered aria-hidden="true">
      <div class="page-fade__layer page-fade__splat" style="--i:0; --tf:translate(0,-20%) scale(0.85)"></div>
      <div class="page-fade__layer page-fade__splat" style="--i:1; --tf:translate(24%,0) scale(-1.28,1.28)"></div>
      <div class="page-fade__layer page-fade__splat" style="--i:2; --tf:translate(-24%,-5%) rotate(180deg) scale(1.28)"></div>
      <div class="page-fade__layer page-fade__splat" style="--i:3; --tf:translate(16%,12%) rotate(90deg) scale(1.4)"></div>
      <div class="page-fade__layer page-fade__splat" style="--i:4; --tf:translate(-16%,10%) rotate(270deg) scale(-1.5,1.5)"></div>
      <!-- Solide EN DERNIER = au-dessus : scelle en noir pur. -->
      <div class="page-fade__layer page-fade__solid"></div>
    </div>

    <slot />

    <!-- ─── Trailer modal (YouTube, lazy, global) ──────────────────────── -->
    <div
      id="trailer-modal"
      class="fixed inset-0 z-[200] hidden items-center justify-center p-4"
      aria-hidden="true"
    >
      <div class="absolute inset-0 bg-background/95 backdrop-blur-sm" data-trailer-close></div>
      <div class="relative w-full max-w-5xl" role="dialog" aria-modal="true" aria-label="Trailer">
        <button
          type="button"
          class="absolute -top-10 right-0 text-foreground-300 hover:text-primary-100 transition-colors"
          data-trailer-close
          aria-label="Close trailer"
        >
          <Icon name="ph:x" class="w-7 h-7" />
        </button>
        <div
          class="trailer-frame aspect-video w-full overflow-hidden border-panel bg-black shadow-cinematic"
        >
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ trailerYouTubeId }}>
      const modal = document.getElementById("trailer-modal")
      if (modal) {
        const frame = modal.querySelector(".trailer-frame")
        const closers = modal.querySelectorAll("[data-trailer-close]")

        const openModal = (id) => {
          const videoId = id || trailerYouTubeId
          frame.innerHTML = `<iframe class="w-full h-full" src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" title="Trailer" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`
          modal.classList.remove("hidden")
          modal.classList.add("flex")
          modal.setAttribute("aria-hidden", "false")
          document.body.style.overflow = "hidden"
          window.lenis?.stop()
        }

        const closeModal = () => {
          modal.classList.add("hidden")
          modal.classList.remove("flex")
          modal.setAttribute("aria-hidden", "true")
          frame.innerHTML = "" // stoppe la lecture
          document.body.style.overflow = ""
          window.lenis?.start()
        }

        document.querySelectorAll("[data-trailer-open]").forEach((btn) => {
          btn.addEventListener("click", () => openModal(btn.dataset.videoId))
        })
        closers.forEach((btn) => btn.addEventListener("click", closeModal))
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal()
        })
      }
    </script>

    <!-- ─── Transition de page : rideau brouillard noir (hard-nav) ──────────
         is:inline pour tourner au premier paint, indépendamment du bundle. -->
    <script is:inline>
      ;(() => {
        const fade = document.getElementById("page-fade")
        if (!fade) return

        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
        // Délai avant navigation = temps pour atteindre le noir plein (--page-fade-cover, CSS).
        const raw = getComputedStyle(document.documentElement).getPropertyValue("--page-fade-cover")
        const COVER = parseFloat(raw) * (raw.includes("ms") ? 1 : 1000) || 1100

        // reduced-motion : aucun rideau, navigation native.
        if (reduced) {
          fade.removeAttribute("data-covered")
          return
        }

        // Révélation à l'arrivée (le rideau démarre couvert).
        const reveal = () => {
          requestAnimationFrame(() => {
            fade.removeAttribute("data-covered")
            window.lenis?.start()
          })
        }
        if (document.readyState === "complete") reveal()
        else window.addEventListener("load", reveal, { once: true })

        // Retour arrière / bfcache : ne jamais laisser la page bloquée sous le rideau.
        window.addEventListener("pageshow", (e) => {
          if (e.persisted) fade.removeAttribute("data-covered")
        })

        // Interception des clics sur liens internes éligibles.
        document.addEventListener("click", (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
          const a = e.target.closest("a[href]")
          if (!a) return
          if (a.target === "_blank" || a.hasAttribute("download")) return

          const href = a.getAttribute("href")
          if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) return

          const url = new URL(href, location.href)
          if (url.origin !== location.origin) return            // lien externe
          if (url.pathname.startsWith("/keystatic")) return      // admin CMS
          if (url.pathname === location.pathname && url.hash) return // ancre même page

          e.preventDefault()
          // Pas de lenis.stop() ici : on navigue en <1s, et le stop retirerait la
          // scrollbar (=> gouttière noire visible + décalage). Le scroll résiduel est
          // invisible sous le rideau.
          fade.setAttribute("data-covered", "")

          // Navigue une fois le noir plein atteint (cascade de splats + fond de sécurité).
          setTimeout(() => { window.location.href = url.href }, COVER)
        })
      })()
    </script>

    <script>
      import "../scripts/smooth-scroll.js"
      import "../scripts/animations.js"
    </script>
  </body>
</html>
