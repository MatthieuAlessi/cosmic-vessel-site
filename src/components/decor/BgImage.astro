---
import { Image } from "astro:assets";
import { cmsImage } from "@lib/images";

interface Props {
  src: string;
  alt?: string;
  opacity?: number;
  position?: string;
  size?: string;
  maskClass?: string;
  fixedBg?: boolean;
  grayscale?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  opacity = 1,
  position = 'object-top',
  size = 'cover',
  maskClass = '',
  fixedBg = false,
  grayscale = false,
  class: className = '',
} = Astro.props;

const positionMap: Record<string, string> = {
  'object-top': 'top',
  'object-center': 'center',
  'object-bottom': 'bottom',
  'object-left': 'left',
  'object-right': 'right',
};
const bgPosition = positionMap[position] ?? 'center';

// Optimisation : si `src` vient de src/assets (image uploadée au CMS), on l'optimise
// via <Image>. Uniquement pour le variant non-fixed (<img>) ; le fixed utilise
// background-image en CSS (non optimisable). Sinon (déco en public/) → <img> brut.
const optimized = !fixedBg ? cmsImage(src) : undefined;
const imgClass = ['w-full h-full object-cover', position, grayscale && 'grayscale'].filter(Boolean).join(' ');
---

{fixedBg ? (
  <div
    class:list={['absolute inset-0 z-0 bgimage', maskClass, className]}
    style={`
      background-image: url('${src}');
      background-attachment: fixed;
      background-size: ${size};
      background-position: ${bgPosition};
      opacity: ${opacity};
      ${grayscale ? 'filter: grayscale(1);' : ''}
    `}
    role="img"
    aria-label={alt}
  />
) : (
  <div class:list={['absolute inset-0 z-0 bgimage  ', maskClass, className]}>
    {optimized ? (
      <Image src={optimized} alt={alt} width={1920} layout="none" class={imgClass} style={`opacity: ${opacity}`} />
    ) : (
      <img src={src} alt={alt} class={imgClass} style={`opacity: ${opacity}`} />
    )}
  </div>
)}
