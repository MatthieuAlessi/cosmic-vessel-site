---
import { Image } from "astro:assets";
import { cmsImage } from "@lib/images";

interface Props {
  src: string;
  alt?: string;
  opacity?: number;
  position?: string;
  size?: string;
  maskClass?: string;
  grayscale?: boolean;
  /** Amplitude du parallax en % (~10-30) : l'image défile moins vite que la page.
   *  Ignoré si bgfixedparallax. */
  parallax?: number;
  /** L'image paraît immobile dans le viewport — équivalent de
   *  background-attachment:fixed, mais fonctionnel sur iOS et sans repaint.
   *  Prioritaire sur parallax. Voir bloc "Fixed parallax" de scripts/animations.js. */
  bgfixedparallax?: boolean;
  /** Fond au-dessus de la ligne de flottaison (hero) : chargé en priorité au lieu
   *  d'être lazy. Sans ça <Image> retombe sur loading="lazy" et retarde le LCP. */
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  opacity = 1,
  position = 'object-top',
  size = 'cover',
  maskClass = '',
  grayscale = false,
  parallax = 0,
  bgfixedparallax = false,
  eager = false,
  class: className = '',
} = Astro.props;

const loadingAttrs = eager
  ? { loading: 'eager' as const, fetchpriority: 'high' as const }
  : { loading: 'lazy' as const };

const positionMap: Record<string, string> = {
  'object-top': 'top',
  'object-center': 'center',
  'object-bottom': 'bottom',
  'object-left': 'left',
  'object-right': 'right',
};
const bgPosition = positionMap[position] ?? 'center';

// Optimisation : si `src` vient de src/assets (image uploadée au CMS), on l'optimise
// via <Image>. Sinon (déco en public/) → <img> brut.
const optimized = cmsImage(src);

// Parallax léger : l'image est agrandie de `margin` % de chaque côté et recentrée pour
// que le scroll reste toujours dans cette marge (pas de bord vide découvert). `range`
// traduit cette marge en % de la hauteur de l'image agrandie (unité attendue par yPercent GSAP).
const margin = !bgfixedparallax && parallax ? Math.max(parallax, 8) : 0;
const range = margin ? Number((margin / (1 + (2 * margin) / 100)).toFixed(2)) : 0;

const imgClass = ['w-full h-full object-cover', position, grayscale && 'grayscale', margin && 'absolute inset-x-0']
  .filter(Boolean)
  .join(' ');
const imgStyle = `opacity: ${opacity};${margin ? ` height: ${100 + 2 * margin}%; top: -${margin}%;` : ''}`;

// Fixed parallax : fallback (no-JS / reduced-motion) = <img> object-cover normale, immobile.
// Le bloc "Fixed parallax" de animations.js la redimensionne/translate ensuite pour l'effet
// (image = 1 hauteur de viewport, translatée à l'inverse du scroll — calcul détaillé là-bas).
const fixedParallaxImgClass = ['absolute inset-0 w-full h-full object-cover', position, grayscale && 'grayscale']
  .filter(Boolean)
  .join(' ');
const fixedParallaxImgStyle = `opacity: ${opacity};`;

// `size` ≠ "cover" (ex. "80%" + tuilage) n'a pas d'équivalent en object-cover : ces calques
// gardent un background-image (même script, il ne regarde que l'attribut). Contrepartie :
// pas d'optimisation d'image.
const fixedParallaxBg = bgfixedparallax && size !== 'cover';
const fixedParallaxBgStyle = `
  background-image: url('${src}');
  background-size: ${size};
  background-position: ${bgPosition};
  opacity: ${opacity};
  ${grayscale ? 'filter: grayscale(1);' : ''}
`;
---

{bgfixedparallax ? (
  <div class:list={['absolute inset-0 z-0 bgimage overflow-hidden', maskClass, className]}>
    {fixedParallaxBg ? (
      <div
        class="absolute inset-x-0 top-0 h-full"
        style={fixedParallaxBgStyle}
        role={alt ? 'img' : undefined}
        aria-label={alt || undefined}
        aria-hidden={alt ? undefined : 'true'}
        data-bgfixedparallax={true}
      />
    ) : optimized ? (
      <Image
        src={optimized}
        alt={alt}
        layout="full-width"
        class={fixedParallaxImgClass}
        style={fixedParallaxImgStyle}
        data-bgfixedparallax={true}
        {...loadingAttrs}
      />
    ) : (
      <img
        src={src}
        alt={alt}
        class={fixedParallaxImgClass}
        style={fixedParallaxImgStyle}
        data-bgfixedparallax={true}
        {...loadingAttrs}
      />
    )}
  </div>
) : (
  <div class:list={['absolute inset-0 z-0 bgimage  ', margin && 'overflow-hidden', maskClass, className]}>
    {optimized ? (
      <Image
        src={optimized}
        alt={alt}
        layout="full-width"
        class={imgClass}
        style={imgStyle}
        data-parallax={range || undefined}
        {...loadingAttrs}
      />
    ) : (
      <img src={src} alt={alt} class={imgClass} style={imgStyle} data-parallax={range || undefined} {...loadingAttrs} />
    )}
  </div>
)}
