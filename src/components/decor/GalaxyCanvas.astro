---
// Canvas d'étoiles animé. Le composant ne fait que DÉCLARER le calque : tout le
// rendu vit dans @scripts/galaxy.js, qui pilote toutes les instances de la page
// avec une seule boucle rAF et ne dessine que celles à l'écran.
//
// ⚠️ Ne pas repasser les réglages par `define:vars` : ça force le <script> en
// `is:inline`, donc recopié en entier dans le HTML et ré-exécuté à chaque
// instance. Ils transitent par des data-* ; le <script> ci-dessous, lui, est
// hoisté et dédupliqué par Astro même avec plusieurs <GalaxyCanvas /> sur la page.
interface Props {
  maskClass?: string;
  opacity?: number;
  count?: number;
  class?: string;
  fixed?: boolean;
}
const { maskClass = '', opacity = 0.85, count = 90, class: className = '', fixed = false } = Astro.props;
---

<div
  data-galaxy
  data-galaxy-count={count}
  data-galaxy-fixed={String(fixed)}
  class:list={[fixed ? 'fixed' : 'absolute', 'inset-0 pointer-events-none', maskClass, className]}
  style={`opacity: ${opacity}`}
>
  <canvas class="w-full h-full block"></canvas>
</div>

<script>
  import '@scripts/galaxy.js'
</script>
