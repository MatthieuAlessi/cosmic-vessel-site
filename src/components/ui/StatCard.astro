---
interface Props {
  value?: string;
  label?: string;
  description?: string;
  icon?: string;
  class?: string;
}
import { Icon } from 'astro-icon/components';
import CornerOrnament from '@components/decor/CornerOrnament.astro';
const { value, label, description, icon, class: className = '' } = Astro.props;
---

<div class:list={['group bg-background-500/30 border-panel frame-gilded shadow-lg shadow-black/30 relative flex flex-col justify-between gap-2 md:gap-6 p-4 md:p-6 lg:p-10', className]}>
  <CornerOrnament size={34} corner="top-left" class="opacity-80" />
  <CornerOrnament size={34} corner="bottom-right" class="opacity-80" />
  <div class="flex items-center justify-between">
    <span class="title-4  text-[10px] pt-5 sm:pt-0  ">{label}</span>
    {icon && (
      <span class="relative flex items-center justify-center w-8 lg:w-10 hidden sm:flex aspect-square rounded-full shrink-0 border border-primary-300/50 text-primary-300">
        <Icon name={icon} class="relative w-5  h-5" />
      </span>
    )}
  </div>

  <div>
    <p class="font-display text-5xl lg:text-7xl tracking-[-0.02em] text-primary-100 leading-none mb-3  ">{value}</p>
    <p class="text-foreground-500 font-body text-xs xl:text-sm leading-relaxed">{description}</p>
  </div>
</div>
