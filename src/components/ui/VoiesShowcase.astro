---
import ClassCard from '@components/ui/ClassCard.astro';
import SpellCard from '@components/ui/SpellCard.astro';
import DividerH from '@components/decor/DividerH.astro';
import BgImage from '@components/decor/BgImage.astro';
import Divider from '@components/decor/Divider.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import GalaxyCanvas from '@components/decor/GalaxyCanvas.astro';

// Même source que VoiesSection (collection `classes`) — cette section en est une
// variante de mise en page : pile de cartes à gauche, rangée de cartes étalées
// puis détail de la voie (texte + sorts) à droite.
const voies = (await getCollection('classes')).map((entry, i) => ({
  name: entry.data.name,
  role: entry.data.tagline,
  description: entry.data.description,
  art: entry.data.image ?? `https://picsum.photos/seed/voie-${i + 1}/800/1200`,
  spells: (entry.data.spells ?? []).map((s, si) => ({
    image: s.image ?? `https://picsum.photos/seed/voie-${i + 1}-spell-${si}/200`,
    name: s.name,
    description: s.description,
  })),
}));

interface Props {
  heading?: { label?: string; title?: string; text?: string };
  class?: string;
  [key: string]: unknown;
}
const { heading, class: className = '', ...rest } = Astro.props;

// Étalement de la rangée de miniatures : inclinaison STATIQUE répartie autour du
// centre (aucune animation dessus — seule la lueur distingue la voie active).
const spread = (i: number) => (i - (voies.length - 1) / 2) * 4;

// Flèches en pastille, à cheval sur les bords de la pile (centrées verticalement).
// La colonne fait désormais la largeur exacte de l'empilement : il n'y a plus de
// place à côté, elles se posent donc par-dessus. Fond opaque + blur pour rester
// lisibles sur l'illustration.
const arrowClass =
  'absolute top-1/2 -translate-y-1/2 z-50 inline-flex items-center justify-center w-10 h-10 rounded-full border border-primary/50 bg-background-700/85 backdrop-blur-sm text-primary-100 shadow-img-lift transition-colors duration-300 hover:bg-primary/25 hover:border-primary cursor-pointer';
---

<section
  class:list={['voies-showcase relative bg-background-300 py-10 lg:py-28 overflow-clip', className]}
  {...rest}
>


      <!-- Décor : cercles (identique à la section Classes home) -->
  <div class="relative z-1">
    <Divider position="unset" class="top-1/2" />
    <div class="cercle z-10 absolute inset-x-0 mx-auto w-1/2 bottom-0 translate-y-[50%]">
      <div class="aspect-square border border-width-1 border-primary-300 rounded-full opacity-30"></div>
    </div>
    <div class="cercle z-10 absolute inset-x-0 mx-auto w-full bottom-0 translate-y-[50%]">
      <div class="aspect-square border border-width-1 border-primary-300 rounded-full opacity-10"></div>
    </div>
  </div>

  <div class="relative z-20">
    <div class="cercle z-10 absolute inset-x-0 mx-auto w-50 bottom-0 translate-y-[50%]">
      <div class="aspect-square border border-width-1 border-primary-300 rounded-full opacity-20"></div>
      <div class="dot absolute top-0 inset-x-0 m-auto w-1.5 aspect-square rounded-full bg-black border-primary-700 border translate-y-[-40%]"></div>
      <div class="dot absolute bottom-0 inset-x-0 m-auto w-1.5 aspect-square rounded-full bg-primary translate-y-[40%]"></div>
    </div>
  </div>

  <!-- <div class="absolute inset-0 m-auto left-1/2 top-0 h-full border-l border-primary-300 opacity-20 z-1"></div> -->

  <BgImage
    src="/src/assets/images/decor/smoke1.jpeg"
    opacity={0.15}
    position="object-bottom"
    size="cover"
    class="mix-blend-hard-light z-1"
  />

  <div class="overlay-top z-1 opacity-90"></div>
  <div class="overlay-bottom z-1 opacity-90"></div>

  <BgImage
    src="/images/galaxy-texture.webp"
    opacity={0.25}
    grayscale
    bgfixedparallax
    position="object-center"
    size="80%"
    maskClass="mask-galaxy"
    class="z-10"
  />

  <GalaxyCanvas opacity={0.5} count={180} class="z-20" />


  <div class="relative z-20 max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- En-tête : label + titre à gauche, paragraphe à droite -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-16 items-end mb-8 lg:mb-20">
      <div>
        <p class="section-label mb-4">{heading?.label}</p>
        <h2 class="title-1 anim-blur">{heading?.title}</h2>
        <DividerH width="max-w-sm" class="mt-6" />
      </div>
      <p class="text-foreground-300 font-body text-sm lg:text-base leading-relaxed">
        {heading?.text}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] gap-6 lg:gap-32 items-start">

      <!-- Colonne gauche : pile de cartes alignée au bord du container.
           `w-[84%]` (et non 100%) parce que l'empilement déborde vers la droite :
           c'est la marge qu'il lui faut pour rester dans la colonne. Les flèches
           sont ancrées au wrapper (pleine colonne), donc à cheval sur les bords
           de l'empilement complet — pas sur ceux de la seule carte de devant. -->
      <div class="hidden lg:block relative w-full">
        <div class="voies-deck w-full lg:w-[84%] mr-auto pb-10">
          {voies.map((voie) => (
            <div class="voies-deck__item">
              <ClassCard tilt discover={false} name={voie.name} tagline={voie.role} art={voie.art} />
            </div>
          ))}
        </div>

        <button type="button" class={`voies-showcase__prev ${arrowClass} left-0 lg:-translate-x-1/2`} aria-label="Voie précédente">
          <Icon name="lucide:chevron-left" class="w-5 h-5" />
        </button>
        <button type="button" class={`voies-showcase__next ${arrowClass} right-0 lg:translate-x-1/2`} aria-label="Voie suivante">
          <Icon name="lucide:chevron-right" class="w-5 h-5" />
        </button>
      </div>

      <!-- Colonne droite : rangée de cartes étalées (desktop) ou carrousel
           grande carte (mobile) + texte de la voie -->
      <div>
        <!-- Desktop (≥ lg) uniquement : rangée de miniatures compactes en éventail
             statique (--rot). Remplacée sous lg par le carrousel juste en dessous. -->
        <!-- hidden!/lg:block! : la classe `.swiper` de la lib pose `display: block`
             en dehors des layers Tailwind et l'emporte sur un simple `hidden`
             (même spécificité, mais après dans la cascade) — d'où l'important. -->
        <div class="voies-spread swiper py-2 lg:mx-0! lg:ml-8 lg:overflow-visible! hidden! lg:block!">
          <div class="swiper-wrapper items-end" role="tablist" aria-label="Choisir une voie">
          {voies.map((voie, i) => (
            <button type="button" role="tab" aria-selected="false" data-index={i} class="voie-thumb swiper-slide" style={`--rot: ${spread(i)}deg`}>
              <ClassCard variant="compact" name={voie.name} art={voie.art} />
              </button>
            ))}
          </div>
        </div>

        <!-- Mobile (< lg) uniquement : même carrousel "grande carte" que la home
             (Classes) — cartes qui débordent au bord de l'écran, inclinaison 3D
             légère + inertie sur le déplacement (voies-mobile-swiper.js). Chaque
             carte EST un `.voie-thumb` comme les miniatures desktop ci-dessus : le
             swipe/tap sélectionne la voie via la logique centralisée de
             voies-showcase.js (indexée par `data-index`, pas la position dans le
             DOM — il existe donc deux groupes de `.voie-thumb` en parallèle). -->
        <div class="relative -mx-4 sm:-mx-6 lg:hidden">
          <div class="voies-mobile swiper py-4">
            <div class="swiper-wrapper" role="tablist" aria-label="Choisir une voie">
              {voies.map((voie, i) => (
                <button type="button" role="tab" aria-selected="false" data-index={i} class="voie-thumb swiper-slide">
                  <ClassCard tilt discover={false} name={voie.name} tagline={voie.role} art={voie.art} />
                </button>
              ))}
            </div>
          </div>

          <button
            type="button"
            aria-label="Voie précédente"
            class="voies-mobile__prev absolute left-2 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-7 h-7 shrink-0 rounded-full border border-primary/40 bg-background-500/40 backdrop-blur-sm text-primary-100 transition-colors hover:bg-primary/10 [&.swiper-button-disabled]:opacity-30"
          >
            <Icon name="ph:caret-left" class="w-3.5 h-3.5" />
          </button>
          <button
            type="button"
            aria-label="Voie suivante"
            class="voies-mobile__next absolute right-2 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-7 h-7 shrink-0 rounded-full border border-primary/40 bg-background-500/40 backdrop-blur-sm text-primary-100 transition-colors hover:bg-primary/10 [&.swiper-button-disabled]:opacity-30"
          >
            <Icon name="ph:caret-right" class="w-3.5 h-3.5" />
          </button>
        </div>
        <div class="voies-mobile__dots mt-6 flex items-center justify-center gap-2 lg:hidden"></div>

        <div class="layer-stack mt-6 lg:mt-14">
          {voies.map((voie, i) => (
            <div class="layer" data-voie-panel={i}>
              <p class="section-label mb-4">{voie.role}</p>
              <h3 class="title-2 text-metal">{voie.name}</h3>
         
          <div class="  w-full mx-auto border-t border-primary-300/10 my-6"></div>


              <div class="columns-1 md:columns-2 gap-8 space-y-4">
                {voie.description?.split('\n\n').map((para) => (
                  <p class="text-foreground-300 font-body text-xs leading-relaxed break-inside-avoid">{para}</p>
                ))}
              </div>

              {voie.spells.length > 0 && (
                <>
                  <p class="font-display text-base uppercase text-foreground-100 mt-10 mb-4">Class Spells</p>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {voie.spells.map((spell) => (
                      <SpellCard image={spell.image} alt={spell.name} name={spell.name} description={spell.description} />
                    ))}
                  </div>
                </>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>

  <!-- <Divider position="bottom" /> -->
</section>

<script>
  import '../../scripts/voies-showcase.js';
  import '../../scripts/voies-mobile-swiper.js';
</script>
