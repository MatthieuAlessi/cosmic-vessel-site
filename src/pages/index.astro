    {/* -mx-* + md:mx-0 : casse le padding du conteneur sur mobile uniquement, pour que le swiper
        (et les cartes voisines qu'il laisse déborder) touche le bord de l'écran. */}
    <div class="relative -mx-4 sm:-mx-6 md:mx-0">
      <div class="class-swiper swiper py-4 md:py-0 md:overflow-visible!">
        <div class="class-cards-grid swiper-wrapper md:grid! md:grid-cols-4 md:gap-4 lg:gap-8 2xl:gap-10">
          {subclasses.map((sub, i) => (
            <div class="swiper-slide h-auto md:w-auto!">
              <ClassCard
                tilt
                href="/character"
                data-index={i}
                name={sub.data.name}
                tagline={sub.data.tagline}
                art={sub.data.image}
              />
            </div>
          ))}
        </div>
      </div>

      {/* Hors du conteneur `.class-swiper` (overflow:hidden du Swiper) pour ne pas être rognées. */}
      <button
        type="button"
        aria-label="Carte précédente"
        class="class-swiper__prev absolute left-6 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-7 h-7 shrink-0 rounded-full border border-primary/40 bg-background-500/40 backdrop-blur-sm text-primary-100 transition-colors hover:bg-primary/10 [&.swiper-button-disabled]:opacity-30 md:hidden"
      >
        <Icon name="ph:caret-left" class="w-3.5 h-3.5" />
      </button>

      <button
        type="button"
        aria-label="Carte suivante"
        class="class-swiper__next absolute right-6 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-7 h-7 shrink-0 rounded-full border border-primary/40 bg-background-500/40 backdrop-blur-sm text-primary-100 transition-colors hover:bg-primary/10 [&.swiper-button-disabled]:opacity-30 md:hidden"
      >
        <Icon name="ph:caret-right" class="w-3.5 h-3.5" />
      </button>
    </div>

    <div class="class-swiper__dots mt-6 flex items-center justify-center gap-2 md:hidden"></div>

    <script>
      import "../scripts/class-cards-swiper.js"
    </script>
  </div>

  <Divider position="bottom" />
</section>


