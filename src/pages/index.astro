---
import Layout from "@layouts/Layout.astro"
import Nav from "@components/ui/Nav.astro"
import Footer from "@components/ui/Footer.astro"
import BgImage from "@components/decor/BgImage.astro"
import DividerH from "@components/decor/DividerH.astro"
import CornerOrnament from "@components/decor/CornerOrnament.astro"
import StarMarks from "@components/decor/StarMarks.astro"
import GalaxyCanvas from "@components/decor/GalaxyCanvas.astro"
import CircleSmall from "@components/decor/CircleSmall.astro"
import Divider from "@components/decor/Divider.astro"
import DividerV from "@components/decor/DividerV.astro"
import Button from "@components/ui/Button.astro"
import Card from "@components/ui/Card.astro"
import ClassTextPanel from "@components/ui/ClassTextPanel.astro"
import RoadmapDigest from "@components/ui/RoadmapDigest.astro"
import StatCard from "@components/ui/StatCard.astro"
import TrailerCard from "@components/ui/TrailerCard.astro"
import ClassCard from "@components/ui/ClassCard.astro"
import SectionPrefooter from "@components/ui/SectionPrefooter.astro"
import { Icon } from "astro-icon/components"
import { getCollection } from "astro:content"
import { settings, trailerVideoId, modName } from "@data/settings"
import CmsImage from "@components/ui/CmsImage.astro"
import { Image } from "astro:assets"
import charRender from "../assets/images/decor/char.png"

import { homepageData } from "@data/homepage";


const { discordUrl, kofiUrl } = settings

 const { hero, section1, section2, sectioncharacter, sectionclass, gallery, roadmap, team: teamSection, news } = homepageData;

const joinTeamUrl = settings.joinformUrl

// Composition du hero, le temps de comparer. Supprimer la branche non retenue.
// "centered" : axial, trailer après le pitch — "split" : 2 colonnes texte / trailer
const heroLayout: "centered" | "split" = "centered"

 
 

const subclasses = await getCollection("classes")

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)

// ─── Équipe (teaser home) ──────────────────────────────────────────────────
// 8 avatars : les vrais membres (aplatis depuis les entrées département de la
// collection team), complétés par des placeholders pravatar.cc. teamTotal placeholder.
const team = await getCollection("team")
const allMembers = team.flatMap((d) => d.data.members)
const teamAvatars = Array.from({ length: 8 }, (_, i) => ({
  name: allMembers[i]?.name ?? "Team Member",
  avatar: allMembers[i]?.avatar ?? `https://i.pravatar.cc/200?img=${Math.ceil(Math.random() * 70)}`,
}))
const teamTotal = 30
 
