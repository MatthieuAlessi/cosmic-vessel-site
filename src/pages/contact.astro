---
import Layout from "@layouts/Layout.astro"
import Nav from "@components/ui/Nav.astro"
import BgImage from "@components/decor/BgImage.astro"
import CornerOrnament from "@components/decor/CornerOrnament.astro"
import { Icon } from "astro-icon/components"

// ─── Liens communauté (placeholder, à remplacer) ──────────────────────────
const discordUrl = "https://discord.gg/your-invite"
const kofiUrl = "https://ko-fi.com/your-page"
const twitterUrl = "https://x.com/your-handle"
const youtubeUrl = "https://youtube.com/@your-channel"

const socials = [
  { icon: "ph:discord-logo", href: discordUrl, label: "Discord" },
  { icon: "ph:x-logo", href: twitterUrl, label: "X" },
  { icon: "ph:youtube-logo", href: youtubeUrl, label: "YouTube" },
  { icon: "ph:coffee", href: kofiUrl, label: "Ko-fi" },
]

// "Join the team" retiré : les candidatures passent par le Google Form (settings.joinformUrl).
const subjects = ["General question", "Press & media", "Bug report", "Other"]

const fieldClass =
  "w-full bg-background-300/50 border-panel border border-white/10 focus:border-primary px-3 py-2.5 font-body text-white/70 text-sm transition-all duration-300 placeholder:text-foreground-700"
const fieldClassSelect =
  "w-full bg-background-300/50 border-panel border border-white/10 focus:border-primary py-3 px-3 font-body text-white/70 text-sm transition-all duration-300 placeholder:text-foreground-700"
const labelClass = "block font-ui text-sm text-foreground-100 mb-1.5"
---

<Layout
  title="Contact — Cosmic Vessel"
  description="Get in touch with the team behind the Cosmic Vessel mod for Baldur's Gate 3."
>
  <Nav />

  {/* Desktop (lg+) : chaque colonne = 100svh, page sans scroll. Mobile : colonnes empilées, scroll normal. */}
  <main class="lg:h-[100svh] lg:overflow-hidden">
    <div class="grid lg:grid-cols-2 lg:h-full">

      <!-- ─── Colonne gauche : image + texte (panneau "marque") ─────────────── -->
      <section
        class="relative flex flex-col justify-end gap-8 overflow-hidden min-h-[44svh] lg:min-h-0 lg:h-full
               px-6 sm:px-10 lg:px-14 pt-24 pb-10 lg:pt-28 lg:pb-14"
      >
        <BgImage src="/src/assets/images/decor/bg1.jpeg" opacity={1} position="object-center" eager class="z-0" />
        <div class="overlay-vignette2 z-0"></div>
        <CornerOrnament size={34} corner="bottom-left" tone="white" class="opacity-50 z-10" />

        <div class="relative z-10 flex items-center gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="flex items-center justify-center w-10 aspect-square rounded-full border border-white/25 text-foreground-100 hover:text-primary-100 hover:border-primary-500/60 transition-colors backdrop-blur-sm"
              >
                <Icon name={s.icon} class="w-5 h-5" />
              </a>
            ))
          }
        </div>

        <div class="relative z-10 w-full">
          <p class="section-label mb-4">Contact</p>
          <h1 class="title-section anim-blur text-5xl sm:text-6xl lg:text-7xl xl:text-8xl">Get in touch</h1>
          <p class="text-foreground-300 font-body text-lg mt-6 max-w-lg">
            Questions, feedback, or press inquiries? We're listening.
          </p>
        </div>
      </section>

      <!-- ─── Colonne droite : formulaire ──────────────────────────────────── -->
      <section
        class="relative flex items-center justify-center bg-background-500
               px-6 sm:px-10 lg:px-14 py-12 lg:py-10 lg:h-full lg:overflow-y-auto"
      >
        <div class="w-full max-w-md">
          <h2 class="font-display text-2xl tracking-wide uppercase text-primary-100 mb-1">
            Send us a message
          </h2>
          <p class="text-foreground-500 font-body text-sm mb-6">
            We usually reply within a few days.
          </p>

          <form class="flex flex-col gap-4" method="POST" data-netlify="true" name="contact">
            <input type="hidden" name="form-name" value="contact" />

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class={labelClass}>Full name</label>
                <input type="text" id="name" name="name" required class={fieldClass} />
              </div>
              <div>
                <label for="email" class={labelClass}>Email</label>
                <input type="email" id="email" name="email" required class={fieldClass} />
              </div>
            </div>

            <div>
              <label for="subject" class={labelClass}>Subject</label>
              <select id="subject" name="subject" class:list={[fieldClassSelect, "select-dark"]}>
                {subjects.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>

            <div>
              <label for="message" class={labelClass}>Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                class={`${fieldClass} resize-none`}></textarea>
            </div>

            <button type="submit" class="btn btn--primary w-full py-3 mt-1">
              <Icon name="ph:paper-plane-tilt" class="w-5 h-5" />
              Send message
            </button>
          </form>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  /* <select> : seuls fond + couleur des <option> sont stylables de façon fiable (rendu OS). */
  select option {
    background-color: var(--color-background-500);
    color: var(--color-foreground-100);
  }
</style>
