---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/ui/Nav.astro';
import { modName } from '@data/settings';
---

<Layout title={`404 | Page not found | ${modName}`}>
  <Nav />
  <main class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <p class="font-ui text-8xl font-light text-background-100 mb-6">404</p>
    <h1 class="font-display text-3xl tracking-widest text-primary-100 uppercase mb-4">Page not found</h1>
    <p class="text-foreground-500 font-body mb-10">This page doesn't exist or has moved.</p>
    <a href="/" class="btn btn--outline">Back to home</a>
  </main>
</Layout>
