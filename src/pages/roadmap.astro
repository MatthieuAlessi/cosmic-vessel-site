---
// ── /roadmap ────────────────────────────────────────────────────────────────
// Board par métier avec sommaire sticky à gauche (scroll-spy). Pas de phases
// (non chronologique, volontaire).
import Layout from "@layouts/Layout.astro"
import Nav from "@components/ui/Nav.astro"
import Footer from "@components/ui/Footer.astro"
import PageHero from "@components/ui/PageHero.astro"
import RoadmapSummary from "@components/ui/RoadmapSummary.astro"
import RoadmapBoard from "@components/ui/RoadmapBoard.astro"
import RoadmapToc from "@components/ui/RoadmapToc.astro"
import { roadmapPageData } from "@data/roadmappage"

const { hero } = roadmapPageData
---

<Layout title="Roadmap — Cosmic Vessel">
  <Nav />

  <!-- ─── Hero + compteur ───────────────────────────────────────────────── -->
  <PageHero label={hero?.label} title={hero?.title} description={hero?.description} image={hero?.image}>
    <div class="mt-10 lg:mt-20">
      <RoadmapSummary />
    </div>
  </PageHero>

  <!-- ─── Board par métier (sommaire sticky + features) ─────────────────── -->
  <section class="relative bg-background-500 py-12 lg:py-24">
    <div class="overlay-top"></div>
    <div class="max-w-7xl mx-auto px-4 lg:px-6 relative z-10">
      <div class="text-center mb-10 lg:mb-16">
        <p class="section-label mb-6 mx-auto">The full scope</p>
        <h2 class="title-2 text-primary-300">Development features</h2>
        <!-- <DividerH width="max-w-lg" class="my-8 mx-auto" /> -->
      </div>

      <div class="grid lg:grid-cols-[230px_1fr] gap-5 lg:gap-16">
        <aside class="min-w-0">
          <RoadmapToc class="sticky-header" />
        </aside>
        <div>
          <RoadmapBoard />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
